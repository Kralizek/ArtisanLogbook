{
  "name": "ArtisanLogbook",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "initializeCommand": ["pwsh", "-NoProfile", "-File", "${localWorkspaceFolder}/.devcontainer/initialize-host.ps1"],
  "runArgs": ["--env-file", "${localWorkspaceFolder}/.devcontainer/gh-token.env"],
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y lua5.1 luarocks && sudo luarocks install luacheck",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ]
    }
  }
}
