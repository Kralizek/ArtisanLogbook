<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>artisanlogbook</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <PackageId>ArtisanLogbook.Companion</PackageId>
    <ToolCommandName>artisanlogbook</ToolCommandName>
    <Version>0.1.0</Version>
    <Description>Local crafting history preservation for Artisan Logbook.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tests.Cli" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Spectre.Console.Cli.Extensions.DependencyInjection" />
    <ProjectReference Include="../ImportService/ImportService.csproj" />
    <ProjectReference Include="../Runtime/Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="ValidateFrontendPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(CompanionWebDevelopment)' == 'true'" Text="Production publish cannot use CompanionWebDevelopment=true." />
    <!-- The SDK routes dotnet tool packing through publish targets as well. -->
    <Error Condition="'$(NoBuild)' == 'true' and '$(_IsPacking)' != 'true'" Text="Companion publishing requires a build to validate and embed current frontend assets. Do not use --no-build." />
  </Target>
</Project>
