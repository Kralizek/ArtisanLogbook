<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateEmbeddedFilesManifest Condition="'$(CompanionWebDevelopment)' != 'true'">true</GenerateEmbeddedFilesManifest>
    <DefineConstants Condition="'$(CompanionWebDevelopment)' == 'true'">$(DefineConstants);COMPANION_WEB_DEVELOPMENT</DefineConstants>
    <WebDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '../../web'))</WebDirectory>
    <NpmCommand Condition="'$(OS)' == 'Windows_NT'">npm.cmd</NpmCommand>
    <NpmCommand Condition="'$(NpmCommand)' == ''">npm</NpmCommand>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <FrontendInput Include="$(WebDirectory)src/**/*;$(WebDirectory)*.ts;$(WebDirectory)*.js;$(WebDirectory)*.json;$(WebDirectory)index.html"
                   Exclude="$(WebDirectory)src/graphql/generated/**/*;$(WebDirectory)src/api/generated.ts" />
    <FrontendInput Include="../Runtime/GraphQL/schema.graphql;../Runtime/Api/Contracts/openapi.yaml" />
  </ItemGroup>
  <Target Name="RestoreFrontend" Condition="'$(CompanionWebDevelopment)' != 'true'"
          Inputs="$(WebDirectory)package.json;$(WebDirectory)package-lock.json"
          Outputs="$(WebDirectory)node_modules/.companion-restore">
    <Exec Command="$(NpmCommand) ci --no-audit --no-fund" WorkingDirectory="$(WebDirectory)" />
    <Touch Files="$(WebDirectory)node_modules/.companion-restore" AlwaysCreate="true" />
  </Target>
  <Target Name="RecordFrontendInputs" DependsOnTargets="RestoreFrontend" Condition="'$(CompanionWebDevelopment)' != 'true'">
    <WriteLinesToFile File="$(WebDirectory)node_modules/.companion-inputs" Lines="@(FrontendInput->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Target Name="BuildFrontend" Condition="'$(CompanionWebDevelopment)' != 'true'"
          DependsOnTargets="RecordFrontendInputs"
          Inputs="@(FrontendInput);$(WebDirectory)node_modules/.companion-restore;$(WebDirectory)node_modules/.companion-inputs"
          Outputs="$(WebDirectory)dist/index.html">
    <Exec Command="$(NpmCommand) run build" WorkingDirectory="$(WebDirectory)" />
  </Target>
  <!-- Enumerate after Vite, not during project evaluation on a clean checkout. -->
  <Target Name="IncludeFrontend" BeforeTargets="_CalculateEmbeddedFilesManifestInputs;AssignTargetPaths" DependsOnTargets="BuildFrontend"
          Condition="'$(CompanionWebDevelopment)' != 'true'">
    <Error Condition="!Exists('$(WebDirectory)dist/index.html')" Text="The production frontend is missing." />
    <ItemGroup>
      <EmbeddedResource Include="$(WebDirectory)dist/**/*" />
      <EmbeddedResource Update="$(WebDirectory)dist/**/*">
        <Link>wwwroot/%(EmbeddedResource.RecursiveDir)%(EmbeddedResource.Filename)%(EmbeddedResource.Extension)</Link>
      </EmbeddedResource>
    </ItemGroup>
  </Target>
  <Target Name="RejectDevelopmentPublish" BeforeTargets="PrepareForPublish"
          Condition="'$(CompanionWebDevelopment)' == 'true'">
    <Error Text="Production publish cannot use CompanionWebDevelopment=true. Publish with the default production asset build." />
  </Target>
</Project>
