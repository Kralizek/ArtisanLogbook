<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <HotChocolateImplicitUsings>disable</HotChocolateImplicitUsings>
    <AssemblyName>ArtisanLogbook.Companion.Runtime</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tests.Cli" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MinimalOpenAPI" />
    <PackageReference Include="HotChocolate.AspNetCore" />
    <PackageReference Include="System.Reactive" />
    <ProjectReference Include="../ImportService/ImportService.csproj" />
    <ProjectReference Include="../WebAssets/WebAssets.csproj" />
    <OpenApi Include="Api/Contracts/openapi.yaml" Namespace="CompanionApi" PublishAs="/openapi/v1.yaml"
             DisplayName="Artisan Logbook Companion API" DisplayVersion="1.0.0"
             ExcludeStatusCodesFromHandlers="403;411;413;415;500" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Api/Contracts/openapi.yaml" LogicalName="ArtisanLogbook.Companion.OpenApi" />
  </ItemGroup>
</Project>
