{
  "name": "artisan-logbook-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.1 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "postinstall": "node -e \"require('node:fs').writeFileSync('node_modules/.companion-restore', '')\"",
    "dev": "npm run codegen && vite",
    "build": "npm run codegen && npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:development": "node scripts/smoke-development.mjs",
    "codegen": "graphql-codegen --config codegen.ts && openapi-typescript ../src/Runtime/Api/Contracts/openapi.yaml -o src/api/generated.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@apollo/client": "4.3.8",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "graphql": "17.1.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/client-preset": "7.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "graphql-sock": "1.0.1",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
